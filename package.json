{
  "name": "next.js-mcp-server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:ui && next build",
    "build:ui": "vite build --config vite.mcp.config.ts",
    "start": "next start",
    "type-check": "tsc --noEmit",
    "test": "node --test --import ./scripts/alias-loader.mjs \"tests/**/*.test.ts\"",
    "lint": "eslint .",
    "test:client": "node scripts/test-client.mjs",
    "golden": "node --import ./scripts/alias-loader.mjs scripts/golden-check.mjs",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "scrape": "node host/job-hunter/scraper/cli.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@better-auth/mcp": "^1.7.7",
    "@better-auth/oauth-provider": "^1.7.7",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/server": "^2.0.0",
    "@prisma/adapter-better-sqlite3": "^7.0.0",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@radix-ui/react-collapsible": "^1.1.21",
    "@radix-ui/react-slot": "^1.4.0",
    "@tailwindcss/postcss": "^4.3.3",
    "better-auth": "^1.7.7",
    "better-sqlite3": "^12.0.0",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "dotenv": "^17.0.0",
    "fast-xml-parser": "^5.11.2",
    "jose": "^6.2.12",
    "lucide-react": "^1.52.0",
    "mcp-handler": "^2.0.0",
    "next": "^15.2.6",
    "pdf-lib": "^1.17.1",
    "pg": "^8.0.0",
    "playwright-core": "^1.63.0",
    "postcss": "^8.5.28",
    "puppeteer": "^25.12.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "shadcn": "^4.21.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.3",
    "vite-plugin-singlefile": "^2.3.3",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.0",
    "@eslint/eslintrc": "^3.3.3",
    "@modelcontextprotocol/client": "^2.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20",
    "@types/pg": "^8.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "^15.2.6",
    "prisma": "^7.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  },
  "engines": {
    "node": "22.x"
  },
  "packageManager": "npm@11.19.0",
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "unrs-resolver@1.12.2": true
